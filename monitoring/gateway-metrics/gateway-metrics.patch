+import { Injectable, NestMiddleware } from '@nestjs/common';
+import { NextFunction, Request, Response } from 'express';
+import { MetricsService } from './metrics.service';
+
+@Injectable()
+export class MetricsMiddleware implements NestMiddleware {
+  constructor(private readonly metricsService: MetricsService) {}
+
+  use(req: Request, res: Response, next: NextFunction): void {
+    const start = process.hrtime.bigint();
+
+    res.on('finish', () => {
+      // Se usa el patron de la ruta (/api/users/:id) y no la URL real,
+      // para no crear una serie distinta por cada id.
+      const routePath = (req.route as { path?: string } | undefined)?.path;
+      const route = routePath ? `${req.baseUrl}${routePath}` : 'sin_ruta';
+
+      // El propio scrape de Prometheus no cuenta como trafico de la app.
+      if (route.endsWith('/metrics')) return;
+
+      const seconds = Number(process.hrtime.bigint() - start) / 1e9;
+      this.metricsService.observe(req.method, route, res.statusCode, seconds);
+    });
+
+    next();
+  }
+}
