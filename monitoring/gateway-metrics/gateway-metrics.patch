+import { INestApplication } from '@nestjs/common';
+import { Test } from '@nestjs/testing';
+import * as request from 'supertest';
+import { HealthCheckModule } from '../health-check/health-check.module';
+import { MetricsModule } from './metrics.module';
+
+describe('Metricas de Prometheus', () => {
+  let app: INestApplication;
+
+  beforeAll(async () => {
+    const moduleRef = await Test.createTestingModule({
+      imports: [HealthCheckModule, MetricsModule],
+    }).compile();
+
+    app = moduleRef.createNestApplication();
+    await app.init();
+  });
+
+  afterAll(async () => {
+    await app.close();
+  });
+
+  it('expone /metrics en formato Prometheus', async () => {
+    const res = await request(app.getHttpServer()).get('/metrics');
+
+    expect(res.status).toBe(200);
+    expect(res.headers['content-type']).toContain('text/plain');
+    expect(res.text).toContain('process_cpu_seconds_total');
+  });
+
+  it('cuenta las peticiones y mide su duracion', async () => {
+    await request(app.getHttpServer()).get('/');
+    await request(app.getHttpServer()).get('/ruta-que-no-existe');
+
+    const res = await request(app.getHttpServer()).get('/metrics');
+
+    expect(res.text).toMatch(
+      /http_requests_total\{method="GET",route="\/",status_code="200"\} 1/,
+    );
+    expect(res.text).toMatch(
+      /http_requests_total\{method="GET",route="sin_ruta",status_code="404"\} 1/,
+    );
+    expect(res.text).toContain('http_request_duration_seconds_bucket');
+    expect(res.text).not.toMatch(/route="\/metrics"/);
+  });
+});
